NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Production origin used in password-reset and notification links.
# Example: https://pharma-college-erp.vercel.app
NEXT_PUBLIC_APP_URL=

# Server-only. Required to create the first administrator, lock /setup,
# mark fees paid, and send Resend password-reset links.
# One-line JSON of the Firebase service account. Never commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email via Resend. Both are required or email is skipped.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Office <office@your-domain.com>

# SMS (DLT) and WhatsApp via MSG91. Missing values skip that channel.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GPCOLG
MSG91_SMS_TEMPLATE_ID=
# Older names still accepted as fallbacks for the two SMS fields above.
MSG91_SENDER=
MSG91_TEMPLATE_ID=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_TEMPLATE_NAME=
# Optional. Defaults to en. Set the namespace if MSG91 requires it.
MSG91_WHATSAPP_LANGUAGE=en
MSG91_WHATSAPP_NAMESPACE=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
