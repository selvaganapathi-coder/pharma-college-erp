rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function validImage() {
      return request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /students/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && validImage();
    }
    match /staff/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && validImage();
    }
    match /departments/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && validImage();
    }
    match /books/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && validImage();
    }
    match /routes/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && validImage();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
